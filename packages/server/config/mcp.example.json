    },
    "semantic-scholar": {
      "disabled": true,
      "command": "npx",
      "args": ["-y", "@yogsoth-ai/semantic-scholar-mcp@latest"]
    },
    "youtube-transcript": {
      "disabled": true,
      "command": "npx",
      "args": ["-y", "@kimtaeyoon83/mcp-server-youtube-transcript"]
